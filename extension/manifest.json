{
  "manifest_version": 3,
  "name": "Injection Shield",
  "version": "0.2.0",
  "description": "Finds hidden instructions aimed at AI assistants on the current page. Runs on your device and sends nothing anywhere.",
  "permissions": ["activeTab", "scripting"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Injection Shield",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}
